# Nusxa oling: .env nomi bilan saqlang va qiymatlarni to'ldiring.
# Bu fayl hech kimga yuborilmaydi.

# BotFather bergan token
BOT_TOKEN=

# Botning username'i (@ belgisiz)
BOT_USERNAME=nasiya_hisobi_uz_bot

# Sotuvchi telefon raqami (bir nechta bo'lsa vergul bilan)
SELLER_PHONES=944559955

# Ilovaning internetdagi HTTPS manzili (masalan https://nasiya.example.com)
APP_URL=

# Server porti
PORT=3000

# Ma'lumotlar bazasi fayli
DB_PATH=./data/nasiya.db

# Eslatmalar yuboriladigan soat (Toshkent vaqti)
REMINDER_HOUR=9
